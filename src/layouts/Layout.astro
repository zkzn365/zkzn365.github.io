---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "中科智农（云南）科技有限责任公司 - AI智能体·小程序·跨境电商定制开发",
  description = "中科智农是一家聚焦人工智能技术研发与企业数字化落地的综合型科技服务商，提供AI大模型开发、企业级Agent智能体、小程序开发、跨境电商平台搭建等一站式解决方案"
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="AI大模型,Agent智能体,小程序开发,跨境电商,网络安全,企业数字化,云南昆明,中科智农" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#1d4ed8" />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main class="pt-16">
      <slot />
    </main>
    <Footer />
  </body>
</html>
