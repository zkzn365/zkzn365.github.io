---
const services = [
  'AI 大模型开发与训练',
  '企业级 Agent 智能体',
  '全平台小程序开发',
  '跨境电商解决方案',
];

const quickLinks = [
  { href: '/services', label: '服务项目' },
  { href: '/cases', label: '成功案例' },
  { href: '/about', label: '关于我们' },
  { href: '/contact', label: '联系我们' },
];
---

<footer class="bg-deep-green text-white mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid md:grid-cols-4 gap-12">
      <div class="md:col-span-2">
        <div class="flex items-center gap-2 text-xl font-bold mb-4">
          <span class="w-8 h-8 rounded-lg bg-primary flex items-center justify-center text-primary-foreground text-sm font-bold">智</span>
          中科智农（云南）科技有限责任公司
        </div>
        <p class="text-white/70 mb-6 max-w-md leading-relaxed">
          聚焦人工智能技术研发与企业数字化落地的综合型科技服务商，以 "AI 赋能产业，技术驱动增长" 为核心使命。
        </p>
        <div class="flex gap-4">
          <a href="/contact" class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-6">
            免费咨询
          </a>
          <a href="tel:0086-13997366845" class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors border border-white/20 text-white hover:bg-white/10 h-10 px-6">
            电话联系
          </a>
        </div>
      </div>
      <div>
        <h4 class="font-semibold mb-4 text-white">服务项目</h4>
        <ul class="space-y-3">
          {services.map((s) => (
            <li class="text-white/60 text-sm hover:text-primary transition-colors cursor-default">{s}</li>
          ))}
        </ul>
      </div>
      <div>
        <h4 class="font-semibold mb-4 text-white">联系方式</h4>
        <ul class="space-y-3">
          <li class="flex items-center gap-2">
            <span class="text-lg">📞</span>
            <a href="tel:0086-13997366845" class="text-white/60 text-sm hover:text-primary transition-colors">0086-13997366845</a>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-lg">📧</span>
            <a href="mailto:wangleihd@gmail.com" class="text-white/60 text-sm hover:text-primary transition-colors">wangleihd@gmail.com</a>
          </li>
          <li>
            <div class="flex items-center gap-2 mb-2">
              <span class="text-lg">💬</span>
              <span class="text-white/60 text-sm">微信咨询</span>
            </div>
            <img src="/opc.jpg" alt="微信客服" class="w-24 h-auto rounded-lg" />
            <div class="text-white/40 text-xs mt-1">扫码添加客服</div>
          </li>
        </ul>
      </div>
    </div>
    <div class="mt-12 pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="text-white/50 text-sm">
        © 2026 中科智农（云南）科技有限责任公司 版权所有
      </div>
      <div class="flex flex-wrap gap-6 text-white/50 text-sm">
        <a href="tel:0086-13997366845" class="hover:text-primary transition-colors">电话：0086-13997366845</a>
        <a href="mailto:wangleihd@gmail.com" class="hover:text-primary transition-colors">邮箱：wangleihd@gmail.com</a>
      </div>
    </div>
