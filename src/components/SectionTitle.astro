---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  center?: boolean;
}

const { eyebrow, title, description, center = false } = Astro.props;
---

<div class={`mb-12 ${center ? 'text-center max-w-3xl mx-auto' : ''}`}>
  {eyebrow && (
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary/10 text-primary text-sm font-medium mb-4">
      <span class="size-1.5 rounded-full bg-primary"></span>
      {eyebrow}
    </div>
  )}
  <h2 class="text-3xl md:text-4xl font-bold text-deep-green mb-4 leading-tight">
    {title}
  </h2>
  {description && (
    <p class="text-muted-foreground text-lg leading-relaxed">
      {description}
    </p>
  )}
</div>
