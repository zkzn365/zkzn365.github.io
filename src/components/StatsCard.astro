---
interface Props {
  value: string;
  label: string;
  icon?: string;
}

const { value, label, icon } = Astro.props;
---

<div class="text-center p-6">
  {icon && <div class="text-3xl mb-3">{icon}</div>}
  <div class="text-4xl md:text-5xl font-bold bg-gradient-to-r from-primary to-chart-2 bg-clip-text text-transparent mb-2">
    {value}
  </div>
  <div class="text-muted-foreground font-medium">{label}</div>
</div>
