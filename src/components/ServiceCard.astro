---
interface Props {
  icon: string;
  title: string;
  description: string;
  features?: string[];
  href?: string;
}

const { icon, title, description, features = [], href } = Astro.props;
---

<div class="group relative bg-card rounded-2xl border border-border p-8 hover:border-primary/50 hover:shadow-lg hover:shadow-primary/5 transition-all duration-300 hover:-translate-y-1">
  <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-primary via-primary/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity rounded-t-2xl"></div>
  <div class="size-14 bg-primary/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-primary group-hover:scale-110 transition-all duration-300">
    <span class="text-2xl group-hover:scale-110 transition-transform">{icon}</span>
  </div>
  <h3 class="text-xl font-bold text-deep-green mb-3 group-hover:text-primary transition-colors">
    {title}
  </h3>
  <p class="text-muted-foreground leading-relaxed mb-4">
    {description}
  </p>
  {features.length > 0 && (
    <ul class="space-y-2 mb-6">
      {features.map((f) => (
        <li class="flex items-center gap-2 text-sm text-muted-foreground">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          {f}
        </li>
      ))}
    </ul>
  )}
  {href && (
    <a href={href} class="inline-flex items-center gap-1 text-primary font-medium text-sm group-hover:gap-2 transition-all">
      了解更多
      <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  )}
</div>
