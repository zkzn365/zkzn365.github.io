---
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ServiceCard from '../components/ServiceCard.astro';
import StatsCard from '../components/StatsCard.astro';
import CaseCard from '../components/CaseCard.astro';

const services = [
  {
    icon: '🧠',
    title: 'AI 技术服务',
    description: '大模型训练微调、企业专属知识库、AI Agent 智能体定制开发、Agent 管理平台搭建',
    features: ['大模型训练与微调', '企业专属知识库', 'AI Agent 定制开发', 'Agent 管理平台'],
    href: '/services#ai',
  },
  {
    icon: '💻',
    title: '应用开发服务',
    description: '企业官网建设与域名备案、全平台小程序开发、App 定制开发、企业管理软件',
    features: ['企业官网与域名备案', '全平台小程序开发', 'App 定制开发', '企业管理软件'],
    href: '/services#app',
  },
  {
    icon: '🌍',
    title: '跨境电商方案',
    description: '独立站建设、多语言商城系统、支付物流集成、进出口业务技术支撑',
    features: ['独立站建设', '多语言商城系统', '支付物流集成', '进出口技术支撑'],
    href: '/services#cross-border',
  },
  {
    icon: '🔒',
    title: '网络安全服务',
    description: '安全软件开发、系统安全评估、数据防护、合规咨询等专业安全服务',
    features: ['安全软件开发', '系统安全评估', '数据安全防护', '等保合规咨询'],
    href: '/services#security',
  },
];

const stats = [
  { value: '5+', label: '年行业深耕' },
  { value: '200+', label: '服务企业客户' },
  { value: '50+', label: '专业技术团队' },
  { value: '99%', label: '客户满意度' },
];

const cases = [
  {
    title: '某制造集团 AI 智能客服系统',
    category: 'AI 智能体',
    description: '为大型制造企业打造具备多轮对话、知识库问答、工单自动创建能力的智能客服系统，客服效率提升 70%。',
    tags: ['大模型微调', '知识库', '多轮对话'],
    gradient: 'from-primary/30 to-chart-2/20',
    imageUrl: '/ai-chatbot.jpg',
  },
  {
    title: '跨境电商独立站平台',
    category: '跨境电商',
    description: '为外贸企业搭建多语言多币种独立站，集成国际支付与物流系统，助力快速布局全球市场。',
    tags: ['多语言', '国际支付', '物流对接'],
    gradient: 'from-chart-3/30 to-chart-4/20',
    imageUrl: '/ecommerce-dashboard.jpg',
  },
  {
    title: '某品牌全平台小程序商城',
    category: '小程序开发',
    description: '微信/支付宝/抖音三端合一的品牌小程序商城，支持分销、拼团、积分等多种营销玩法。',
    tags: ['多端合一', '分销系统', '营销玩法'],
    gradient: 'from-chart-2/30 to-chart-5/20',
    imageUrl: '/mini-program.jpg',
  },
  {
    title: '企业级 Agent 管理平台',
    category: 'AI 技术服务',
    description: '为金融机构搭建可扩展的 Agent 管理平台，支持多智能体协同工作，实现业务流程智能化重构。',
    tags: ['Agent 平台', '多智能体', '流程自动化'],
    gradient: 'from-primary/25 to-chart-3/20',
    imageUrl: '/ai-agent-platform.jpg',
  },
  {
    title: '农业 IoT 数据管理系统',
    category: '应用开发',
    description: '为农业企业开发物联网数据采集与管理系统，实现种植环境监测、数据分析与智能决策。',
    tags: ['IoT', '数据可视化', '智能决策'],
    gradient: 'from-chart-4/30 to-primary/20',
    imageUrl: '/agri-iot.jpg',
  },
  {
    title: '等保合规安全评估项目',
    category: '网络安全',
    description: '为多家政务与企业客户提供等保三级合规咨询与技术支撑，顺利通过测评。',
    tags: ['等保三级', '安全评估', '合规咨询'],
    gradient: 'from-chart-5/30 to-chart-2/20',
    imageUrl: '/cybersecurity.jpg',
  },
];

const advantages = [
  {
    icon: '🎯',
    title: '业务价值导向',
    description: '坚持以客户业务价值为核心，将前沿 AI 技术与行业实际场景深度结合，拒绝技术噱头，追求真实落地成效。',
  },
  {
    icon: '⚡',
    title: '高效交付体系',
    description: '标准化项目管理流程，从需求调研、产品设计到开发测试、上线运维，全程可控，确保交付质量与周期。',
  },
  {
    icon: '🛠️',
    title: '灵活定制能力',
    description: '深度理解行业特性，可根据企业个性化需求灵活定制解决方案，真正贴合业务实际。',
  },
  {
    icon: '🤝',
    title: '持续技术支持',
    description: '提供持续的技术支持与运维服务，7×24 小时响应，保障系统稳定运行，陪伴企业共同成长。',
  },
];
---

<Layout title="中科智农 - AI赋能产业，技术驱动增长">
  <!-- Hero Section -->
  <section class="relative min-h-[90vh] flex items-center overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-cream/50 via-background to-primary/5"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(48, 53, 49, 1) 1px, transparent 1px), linear-gradient(90deg, rgba(48, 53, 49, 1) 1px, transparent 1px); background-size: 60px 60px;"></div>
    <div class="absolute top-20 right-10 size-72 bg-primary/20 rounded-full blur-[120px] animate-float"></div>
    <div class="absolute bottom-20 left-10 size-96 bg-chart-2/20 rounded-full blur-[150px] animate-float" style="animation-delay: 2s;"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="animate-fade-in-up">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 text-primary text-sm font-medium mb-6">
            <span class="size-2 rounded-full bg-primary animate-pulse"></span>
            AI 赋能产业 · 技术驱动增长
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-deep-green mb-6 leading-tight">
            聚焦 AI 技术研发
            <br />
            <span class="bg-gradient-to-r from-primary to-chart-3 bg-clip-text text-transparent">
              企业数字化落地
            </span>
          </h1>
          <p class="text-lg text-muted-foreground mb-8 max-w-xl leading-relaxed">
            中科智农（云南）科技有限责任公司，提供从底层技术研发到上层业务落地的全链路数字化解决方案。
            大模型训练 · AI Agent · 小程序 · 跨境电商 · 网络安全，一站式服务。
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="/contact"
              class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-12 px-8 text-base"
            >
              免费获取方案
              <svg xmlns="http://www.w3.org/2000/svg" class="size-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
            <a
              href="/services"
              class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors border border-border hover:bg-muted h-12 px-8 text-base text-deep-green"
            >
              了解服务详情
            </a>
          </div>
        </div>
        <div class="hidden lg:block animate-fade-in-up delay-200">
          <div class="relative">
            <div class="absolute inset-0 bg-gradient-to-br from-primary/20 to-chart-2/20 rounded-3xl blur-2xl"></div>
            <div class="relative bg-card/80 backdrop-blur-sm border border-border rounded-3xl p-8 shadow-2xl">
              <div class="flex items-center gap-3 mb-6 pb-6 border-b border-border">
                <div class="flex gap-2">
                  <div class="size-3 rounded-full bg-red-400"></div>
                  <div class="size-3 rounded-full bg-yellow-400"></div>
                  <div class="size-3 rounded-full bg-green-400"></div>
                </div>
                <span class="text-sm text-muted-foreground ml-2">AI 智能体控制台</span>
              </div>
              <div class="space-y-4">
                <div class="flex gap-3">
                  <div class="size-8 rounded-full bg-primary/20 flex items-center justify-center text-sm shrink-0">🤖</div>
                  <div class="bg-muted rounded-2xl rounded-tl-sm p-4 text-sm text-deep-green">
                    您好，我是您的企业 AI 助手，有什么可以帮您？
                  </div>
                </div>
                <div class="flex gap-3 justify-end">
                  <div class="bg-primary text-primary-foreground rounded-2xl rounded-tr-sm p-4 text-sm max-w-[80%]">
                    帮我分析一下上月的销售数据
                  </div>
                  <div class="size-8 rounded-full bg-chart-2/20 flex items-center justify-center text-sm shrink-0">👤</div>
                </div>
                <div class="flex gap-3">
                  <div class="size-8 rounded-full bg-primary/20 flex items-center justify-center text-sm shrink-0">🤖</div>
                  <div class="bg-muted rounded-2xl rounded-tl-sm p-4 text-sm text-deep-green space-y-2">
                    <p class="font-medium">上月销售数据分析报告：</p>
                    <ul class="text-muted-foreground space-y-1">
                      <li>• 总销售额同比增长 23.5%</li>
                      <li>• 新增客户 186 位</li>
                      <li>• 热销品类：智能设备</li>
                    </ul>
                  </div>
                </div>
              </div>
              <div class="mt-6 pt-6 border-t border-border">
                <div class="flex items-center justify-between text-xs text-muted-foreground">
                  <span class="flex items-center gap-1">
                    <span class="size-1.5 rounded-full bg-green-500"></span>
                    模型运行正常
                  </span>
                  <span>响应时间: 0.8s</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-24 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionTitle
        eyebrow="核心业务"
        title="四大业务板块，全链路数字化服务"
        description="从 AI 技术研发到应用开发落地，从跨境电商到网络安全，为企业提供全方位的数字化转型解决方案。"
        center={true}
      />
      
      <div class="grid md:grid-cols-2 gap-6 lg:gap-8">
        {services.map((service, i) => (
          <div class={`animate-fade-in-up delay-${(i + 1) * 100}`}>
            <ServiceCard {...service} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Core Tech Section -->
  <section class="py-24 bg-cream/30 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.02]" style="background-image: radial-gradient(circle at 2px 2px, #303531 1px, transparent 0); background-size: 40px 40px;"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <SectionTitle
            eyebrow="核心技术"
            title="AI 大模型开发与训练"
            description="公司拥有专业的 AI 算法团队，深耕大模型微调训练、垂直领域知识库构建、多模态应用开发等核心技术方向。"
          />
          <div class="space-y-4">
            <div class="flex items-start gap-4 p-4 bg-card rounded-xl border border-border">
              <div class="size-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                <span class="text-lg">📚</span>
              </div>
              <div>
                <h4 class="font-semibold text-deep-green mb-1">垂直领域知识库</h4>
                <p class="text-sm text-muted-foreground">根据企业业务场景定制训练专属行业模型，实现精准的知识问答与内容生成。</p>
              </div>
            </div>
            <div class="flex items-start gap-4 p-4 bg-card rounded-xl border border-border">
              <div class="size-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                <span class="text-lg">🎨</span>
              </div>
              <div>
                <h4 class="font-semibold text-deep-green mb-1">多模态应用开发</h4>
                <p class="text-sm text-muted-foreground">支持文本、图像、语音等多模态交互，打造丰富的 AI 应用体验。</p>
              </div>
            </div>
            <div class="flex items-start gap-4 p-4 bg-card rounded-xl border border-border">
              <div class="size-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                <span class="text-lg">⚙️</span>
              </div>
              <div>
                <h4 class="font-semibold text-deep-green mb-1">智能决策系统</h4>
                <p class="text-sm text-muted-foreground">将 AI 技术深度融入生产经营全流程，助力企业实现数据驱动的智能决策。</p>
              </div>
            </div>
          </div>
        </div>
        <div>
          <div class="relative">
            <div class="absolute inset-0 bg-gradient-to-br from-primary/10 to-chart-2/10 rounded-3xl blur-2xl"></div>
            <div class="relative bg-card border border-border rounded-3xl overflow-hidden">
              <img
                src="/ai-neural-network.jpg"
                alt="AI 大模型"
                class="w-full h-48 object-cover"
                loading="lazy"
              />
              <div class="p-8">
                <h4 class="font-bold text-deep-green mb-6 text-lg">企业级 Agent 能力矩阵</h4>
                <div class="grid grid-cols-2 gap-4">
                  {[
                    { icon: '💬', name: '智能客服', desc: '7×24 小时在线' },
                    { icon: '📋', name: '流程自动化', desc: '效率提升 80%' },
                    { icon: '📊', name: '数据分析专家', desc: '实时洞察业务' },
                    { icon: '🤝', name: '多 Agent 协同', desc: '复杂任务处理' },
                    { icon: '🔧', name: '工具调用', desc: '对接业务系统' },
                    { icon: '🧩', name: '可扩展平台', desc: '灵活定制开发' },
                  ].map((item) => (
                    <div class="p-4 bg-muted/50 rounded-xl hover:bg-primary/5 hover:border-primary/30 border border-transparent transition-all">
                      <div class="text-2xl mb-2">{item.icon}</div>
                      <div class="font-semibold text-deep-green text-sm">{item.name}</div>
                      <div class="text-xs text-muted-foreground">{item.desc}</div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-20 bg-deep-green text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 50px 50px;"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {stats.map((stat, i) => (
          <div key={i} class="text-center p-4">
            <div class="text-4xl md:text-5xl font-bold text-primary mb-2">{stat.value}</div>
            <div class="text-white/70 font-medium">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Advantages Section -->
  <section class="py-24 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionTitle
        eyebrow="服务优势"
        title="为什么选择中科智农"
        description="立足西南、面向全国，服务覆盖制造业、商贸流通、农业、文旅、跨境贸易等多个行业领域。"
        center={true}
      />
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {advantages.map((adv, i) => (
          <div key={i} class="group p-6 bg-card rounded-2xl border border-border hover:border-primary/50 hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
            <div class="size-14 bg-cream rounded-xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
              <span class="text-2xl">{adv.icon}</span>
            </div>
            <h3 class="text-lg font-bold text-deep-green mb-3 group-hover:text-primary transition-colors">
              {adv.title}
            </h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              {adv.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cases Section -->
  <section class="py-24 bg-cream/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionTitle
        eyebrow="成功案例"
        title="已服务 200+ 企业客户"
        description="从 AI 智能体到跨境电商，从小程序到企业管理系统，我们用技术实力为客户创造真实价值。"
        center={true}
      />
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {cases.slice(0, 6).map((c, i) => (
          <CaseCard key={i} {...c} />
        ))}
      </div>
      
      <div class="text-center mt-12">
        <a
          href="/cases"
          class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors border border-border hover:bg-muted h-11 px-8 text-deep-green"
        >
          查看更多案例
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 bg-background">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-deep-green to-deep-green/90 p-12 md:p-16 text-center">
        <div class="absolute top-0 right-0 size-64 bg-primary/20 rounded-full blur-[100px]"></div>
        <div class="absolute bottom-0 left-0 size-64 bg-chart-2/10 rounded-full blur-[100px]"></div>
        <div class="relative">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
            准备好开启您的数字化之旅了吗？
          </h2>
          <p class="text-white/70 text-lg mb-8 max-w-2xl mx-auto">
            立即联系我们，获取免费咨询和定制方案。让 AI 技术真正赋能您的业务增长。
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/contact"
              class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-12 px-8 text-base"
            >
              免费咨询报价
            </a>
            <a
              href="tel:0086-13997366845"
              class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors border border-white/20 text-white hover:bg-white/10 h-12 px-8 text-base"
            >
              电话咨询
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
