---
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';

const milestones = [
  { year: '2021', title: '公司成立', desc: '中科智农（云南）科技有限责任公司注册成立于中国（云南）自由贸易试验区昆明片区' },
  { year: '2022', title: '业务拓展', desc: '业务覆盖小程序开发、企业官网、管理系统，服务客户突破 50 家' },
  { year: '2023', title: 'AI 布局', desc: '组建 AI 算法团队，开始大模型微调与 Agent 智能体技术研发' },
  { year: '2024', title: '产品升级', desc: '推出企业级 Agent 管理平台，跨境电商业务线成熟，服务客户突破 150 家' },
  { year: '2025', title: '全面发展', desc: '四大业务板块齐头并进，服务客户突破 200 家，技术团队 50+ 人' },
];

const values = [
  { icon: '💡', title: '创新驱动', desc: '持续探索前沿技术，将 AI 与业务场景深度融合' },
  { icon: '🤝', title: '客户至上', desc: '以客户业务价值为导向，追求真实落地成效' },
  { icon: '🎯', title: '务实求真', desc: '拒绝技术噱头，踏踏实实做好每一个项目' },
  { icon: '🚀', title: '追求卓越', desc: '高标准严要求，不断提升交付质量与服务水平' },
];

const industries = [
  '制造业', '商贸流通', '农业', '文旅', '跨境贸易', '金融', '教育', '医疗健康'
];
---

<Layout title="关于我们 - 中科智农">
  <!-- Hero -->
  <section class="py-20 bg-gradient-to-b from-cream/50 to-background relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(48, 53, 49, 1) 1px, transparent 1px), linear-gradient(90deg, rgba(48, 53, 49, 1) 1px, transparent 1px); background-size: 60px 60px;"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 text-primary text-sm font-medium mb-6">
        <span class="size-2 rounded-full bg-primary"></span>
        关于中科智农
      </div>
      <h1 class="text-4xl md:text-5xl font-bold text-deep-green mb-6">
        AI 赋能产业，技术驱动增长
      </h1>
      <p class="text-lg text-muted-foreground max-w-3xl mx-auto leading-relaxed">
        中科智农（云南）科技有限责任公司成立于 2021 年，是一家聚焦人工智能技术研发与企业数字化落地的综合型科技服务商。
      </p>
    </div>
  </section>

  <!-- 公司简介 -->
  <section class="py-24 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <SectionTitle
            eyebrow="公司简介"
            title="专注企业数字化落地的综合型科技服务商"
          />
          <div class="space-y-6 text-muted-foreground leading-relaxed">
            <p>
              中科智农（云南）科技有限责任公司注册于中国（云南）自由贸易试验区昆明片区，
              以 "AI 赋能产业，技术驱动增长" 为核心使命，致力于为各行业客户提供从底层技术研发到上层业务落地的全链路数字化解决方案。
            </p>
            <p>
              公司拥有专业的 AI 算法团队和技术开发团队，深耕大模型微调训练、垂直领域知识库构建、多模态应用开发、
              企业级 AI Agent 定制开发等核心技术方向，可根据企业业务场景定制训练专属行业模型。
            </p>
            <p>
              公司立足西南、面向全国，服务覆盖制造业、商贸流通、农业、文旅、跨境贸易等多个行业领域。
              我们坚持以客户业务价值为导向，将前沿 AI 技术与行业实际场景深度结合，拒绝技术噱头，追求真实落地成效。
            </p>
          </div>
        </div>
        <div class="relative">
          <div class="absolute inset-0 bg-gradient-to-br from-primary/20 to-chart-2/20 rounded-3xl blur-2xl"></div>
          <div class="relative grid grid-cols-2 gap-4">
            <div class="bg-card border border-border rounded-2xl p-6">
              <div class="text-4xl font-bold text-primary mb-2">200+</div>
              <div class="text-muted-foreground">服务企业客户</div>
            </div>
            <div class="bg-card border border-border rounded-2xl p-6 mt-8">
              <div class="text-4xl font-bold text-chart-2 mb-2">50+</div>
              <div class="text-muted-foreground">专业技术团队</div>
            </div>
            <div class="bg-card border border-border rounded-2xl p-6">
              <div class="text-4xl font-bold text-chart-3 mb-2">5+</div>
              <div class="text-muted-foreground">年行业深耕</div>
            </div>
            <div class="bg-card border border-border rounded-2xl p-6 mt-8">
              <div class="text-4xl font-bold text-chart-4 mb-2">99%</div>
              <div class="text-muted-foreground">客户满意度</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 核心技术能力 -->
  <section class="py-24 bg-cream/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionTitle
        eyebrow="核心技术"
        title="两大核心技术能力"
        description="AI 大模型开发训练 + 企业级 Agent 平台构建，打造企业智能化底座"
        center={true}
      />
      
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-card border border-border rounded-3xl p-8 hover:border-primary/30 transition-colors">
          <div class="size-16 bg-primary/10 rounded-2xl flex items-center justify-center text-3xl mb-6">
            🧠
          </div>
          <h3 class="text-2xl font-bold text-deep-green mb-4">AI 大模型开发与训练</h3>
          <p class="text-muted-foreground mb-6 leading-relaxed">
            公司拥有专业的 AI 算法团队，深耕大模型微调训练、垂直领域知识库构建、多模态应用开发等核心技术方向。
            可根据企业业务场景定制训练专属行业模型，实现知识问答、内容生成、数据分析、智能决策等功能。
          </p>
          <ul class="space-y-3">
            {['大模型微调训练', '垂直领域知识库', '多模态应用开发', '智能决策系统'].map((item) => (
              <li class="flex items-center gap-3 text-sm text-muted-foreground">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        
        <div class="bg-card border border-border rounded-3xl p-8 hover:border-primary/30 transition-colors">
          <div class="size-16 bg-chart-2/10 rounded-2xl flex items-center justify-center text-3xl mb-6">
            🤖
          </div>
          <h3 class="text-2xl font-bold text-deep-green mb-4">企业级 Agent 智能体与平台</h3>
          <p class="text-muted-foreground mb-6 leading-relaxed">
            专注于企业级 AI Agent 定制开发与智能体平台搭建，覆盖智能客服、流程自动化、业务助理、数据分析专家等多场景应用。
            打造具备自主决策、多轮执行、工具调用能力的智能体系统，支持多智能体协同工作。
          </p>
          <ul class="space-y-3">
            {['智能客服 Agent', '流程自动化', '多 Agent 协同', 'Agent 管理平台'].map((item) => (
              <li class="flex items-center gap-3 text-sm text-muted-foreground">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-chart-2 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 发展历程 -->
  <section class="py-24 bg-background">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionTitle
        eyebrow="发展历程"
        title="我们的成长之路"
        description="从成立到壮大，每一步都坚实有力"
        center={true}
      />
      
      <div class="relative">
        <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-0.5 bg-border -translate-x-1/2"></div>
        <div class="space-y-12">
          {milestones.map((m, i) => (
            <div key={i} class={`relative flex items-center gap-8 ${i % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
              <div class="hidden md:block md:w-1/2"></div>
              <div class="absolute left-4 md:left-1/2 size-4 rounded-full bg-primary border-4 border-background -translate-x-1/2 z-10"></div>
              <div class="md:w-1/2 pl-12 md:pl-0 md:px-8">
                <div class="bg-card border border-border rounded-2xl p-6 hover:border-primary/30 transition-colors">
                  <div class="text-2xl font-bold text-primary mb-2">{m.year}</div>
                  <h4 class="text-lg font-semibold text-deep-green mb-2">{m.title}</h4>
                  <p class="text-sm text-muted-foreground">{m.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 企业文化 -->
  <section class="py-24 bg-deep-green text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 50px 50px;"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">企业价值观</h2>
        <p class="text-white/70 text-lg">专业、务实、创新、共赢</p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {values.map((v, i) => (
          <div key={i} class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-6 hover:bg-white/10 transition-colors">
            <div class="text-4xl mb-4">{v.icon}</div>
            <h3 class="text-xl font-semibold text-white mb-2">{v.title}</h3>
            <p class="text-white/60 text-sm">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 服务行业 -->
  <section class="py-24 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionTitle
        eyebrow="服务领域"
        title="覆盖多个行业领域"
        description="深耕行业场景，积累丰富的行业解决方案经验"
        center={true}
      />
      
      <div class="flex flex-wrap justify-center gap-4">
        {industries.map((ind, i) => (
          <div
            key={i}
            class="px-6 py-3 bg-cream/50 border border-border rounded-full text-deep-green font-medium hover:bg-primary/10 hover:border-primary/30 hover:text-primary transition-all cursor-default"
          >
            {ind}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 联系信息 -->
  <section class="py-20 bg-cream/30">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-card border border-border rounded-3xl p-8 md:p-12">
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-deep-green mb-3">联系我们</h2>
          <p class="text-muted-foreground">期待与您携手，共同拥抱智能时代的发展机遇</p>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="flex items-start gap-4 p-4 rounded-xl bg-muted/50">
            <div class="size-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
              📍
            </div>
            <div>
              <div class="font-semibold text-deep-green mb-1">公司地址</div>
              <div class="text-sm text-muted-foreground">中国(云南)自由贸易试验区昆明片区经开区顺通大道31号国际珠宝城6栋4层F407-22</div>
            </div>
          </div>
          <div class="flex items-start gap-4 p-4 rounded-xl bg-muted/50">
            <div class="size-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
              📞
            </div>
            <div>
              <div class="font-semibold text-deep-green mb-1">联系电话</div>
              <div class="text-sm text-muted-foreground">0086-13997366845</div>
            </div>
          </div>
          <div class="flex items-start gap-4 p-4 rounded-xl bg-muted/50">
            <div class="size-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
              📧
            </div>
            <div>
              <div class="font-semibold text-deep-green mb-1">电子邮箱</div>
              <div class="text-sm text-muted-foreground">wangleihd@gmail.com</div>
            </div>
          </div>
          <div class="flex items-start gap-4 p-4 rounded-xl bg-muted/50">
            <div class="size-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
              🌐
            </div>
            <div>
              <div class="font-semibold text-deep-green mb-1">官方网站</div>
              <div class="text-sm text-muted-foreground">www.zkzn365.com</div>
            </div>
          </div>
        </div>
        <div class="mt-8 text-center">
          <a
            href="/contact"
            class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-11 px-8"
          >
            在线咨询
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
