---
import Layout from '../layouts/Layout.astro';

const version = 'v0.2.0';
const versionNumber = '0.2.0';
const buildDate = '2026-09-12';
const buildTag = '#10';
const commit = 'e5d21e0';
const repoUrl = 'https://github.com/zkzn365/miniaccount';
const downloadBase = `${repoUrl}/releases/download/${version}`;

// 下载直链：指向 Release 资源本体，点击即开始下载（不跳转发布页）
const downloads = [
  {
    platform: 'Windows',
    icon: '🪟',
    arch: 'amd64 / x64',
    format: 'ZIP',
    size: '14.8 MB',
    desc: 'Windows 10 / 11（64 位）',
    contents: '小账本.exe + miniaccount.exe',
    file: `miniaccount-${versionNumber}-windows-amd64.zip`,
    url: `${downloadBase}/miniaccount-${versionNumber}-windows-amd64.zip`,
    sha256: 'ffb3e0b5dbc8d7af53c0c36b7e162e2b61f208928791b4ef2eff82ba24d780b9',
  },
  {
    platform: 'macOS',
    icon: '🍎',
    arch: 'Universal（Apple 芯片 / Intel）',
    format: 'ZIP',
    size: '15.1 MB',
    desc: 'macOS 11 及以上',
    contents: '小账本.app + miniaccount',
    file: `miniaccount-${versionNumber}-macos-universal.zip`,
    url: `${downloadBase}/miniaccount-${versionNumber}-macos-universal.zip`,
    sha256: '8a0bdab9d29db2d48371d754ba0f767d6ae61ea57a9445a1f6993587e1eab9dd',
  },
  {
    platform: 'Linux',
    icon: '🐧',
    arch: 'amd64 / x64',
    format: 'TAR.GZ',
    size: '14.3 MB',
    desc: 'Ubuntu / Debian 等发行版（64 位）',
    contents: '小账本 + miniaccount + 说明',
    file: `miniaccount-${versionNumber}-linux-amd64.tar.gz`,
    url: `${downloadBase}/miniaccount-${versionNumber}-linux-amd64.tar.gz`,
    sha256: '1b42d3db218752cea40e10bd632ab830522e759ca771f9990da026ea01ac5779',
  },
];

// 软件简介：关键特性
const highlights = [
  {
    icon: '🖥️',
    title: '三平台覆盖',
    desc: 'Windows、macOS（Apple 芯片 / Intel 通用包）、Linux 各一个安装包，功能完全一致。',
  },
  {
    icon: '📦',
    title: '绿色单文件',
    desc: '前端资源用 //go:embed 编进二进制，用户拿到的是一个可执行文件，不需要装 Web 服务器或运行时。',
  },
  {
    icon: '🔒',
    title: '数据只在本机',
    desc: '账套是本地 SQLite 文件，离线可用，财务数据不出本机；备份就是拷走整个 dataDB 目录。',
  },
  {
    icon: '🧮',
    title: '金额不用浮点',
    desc: '金额以 int64 分存储，全链路无浮点误差；冲销用红字凭证，报表汇总不靠隐藏行。',
  },
  {
    icon: '📑',
    title: '真按会计准则来',
    desc: '六类科目（含成本类）、会计期间状态机、顺序结账 / 逆序反结账，科目体系对齐财会〔2016〕22 号。',
  },
  {
    icon: '🤖',
    title: 'AI 辅助记账',
    desc: '银行流水三层匹配（规则 → 历史相似 → AI），AI 生成凭证走严格契约与护栏，先落草稿再人工确认。',
  },
];

// 软件简介：规格表
const specs = [
  { label: '软件名称', value: '小账本（Mini Account）' },
  { label: '当前版本', value: `${version} · 构建 ${buildTag}（${buildDate}）` },
  { label: '开源许可', value: 'MIT，独立实现，永久免费、无需注册' },
  { label: '运行环境', value: 'Windows 10/11、macOS 11+、Linux（GTK3 + WebKitGTK）' },
  { label: '存储方式', value: '本地 SQLite 单文件账套，离线运行' },
  { label: '账套位置', value: '~/.mini-account/dataDB/' },
  { label: '安装包内含', value: '界面版「小账本」+ 命令行版「miniaccount」' },
];

// 适用对象
const audiences = [
  { icon: '🏪', title: '小微企业', desc: '需要一套能出资产负债表、利润表的正经账，但不想为进销存 ERP 付费。' },
  { icon: '🧾', title: '个体工商户', desc: '票据不多、科目不复杂，希望一本账看清收支与往来欠款。' },
  { icon: '💼', title: '代账会计', desc: '一台电脑给多家公司做账，按账套分别记账、分别署名、分别备份。' },
  { icon: '🚀', title: '创业公司', desc: '早期没有专职财务，用免费工具先把账建起来，后面换系统也能导出。' },
];

// 功能模块（对齐 v0.2.0 实际已实现页面）
const modules = [
  {
    icon: '🗂️',
    title: '建账与账套',
    features: ['建账向导，可一键生成演示账套先看效果', '账套 = 一个本地 SQLite 文件，可多账套并存', '账套信息维护、附件审计、AI 配置', '账套级「记账人」：录凭证、过账、结账自动署名'],
  },
  {
    icon: '📝',
    title: '凭证管理',
    features: ['凭证录入与列表，借贷平衡强制校验', '状态机：草稿 → 记账 → 红字冲销', '按「期间 + 凭证字」分配凭证号，断号可查', '凭证附件按 sha256 内容寻址存储，同文件只占一份'],
  },
  {
    icon: '🏦',
    title: '银行流水与日记账',
    features: ['对账单 CSV 导入（自动嗅探 GB18030 编码）', '三层匹配：规则 → 历史相似 → AI', '点单元格就地指定对方科目，需辅助核算自动弹窗', '批量生成凭证、匹配规则管理、银行余额调节表'],
  },
  {
    icon: '📊',
    title: '报表与账簿',
    features: ['资产负债表、利润表、现金流量表（直接法）', '总账、明细账、日记账（带「对方科目」）', '多栏式明细账（管理费用、应交增值税专用格式）', '凭证汇总表、科目余额表，27 张报表清单已收官'],
  },
  {
    icon: '🔍',
    title: '查询与分析',
    features: ['报表统一下钻，可从报表一路查到凭证', '账龄分析：先进先出法核销 + 30/60/90/180/365 天分桶', '对账单：发给客户 / 供应商核对盖章', '操作日志：可查、可导出、哈希链校验是否被改动'],
  },
  {
    icon: '💰',
    title: '工资模块',
    features: ['员工档案 / 外聘劳务人员', '工资单录入，个税累计预扣预缴', '社保公积金方案自定义（费率由你填，不预置）', '一键生成工资会计凭证'],
  },
  {
    icon: '🧾',
    title: '发票与报销',
    features: ['发票档案（专票 / 普票），可抵扣税额自动判定', '一键生成进项 / 销项凭证', '差旅报销：草稿 → 审批 → 记账完整流转', '报销单一键生成会计凭证'],
  },
  {
    icon: '📅',
    title: '账期与期末',
    features: ['账期体检 → 结账 → 反结账（逆序）', '期末结转损益、年末结转本年利润', '结账前体检，把不平的分录先挑出来', '增值税助手：查适用税率、判进项能否抵扣'],
  },
  {
    icon: '📤',
    title: '导出与备份',
    features: ['报表导出 Excel，打印 / 另存 PDF', '.mabak 备份：数据库快照 + 附件打成一个文件', '恢复前先看清单（inspect），出错自动回滚', '命令行与界面功能对等，可脚本化'],
  },
];

// 设计取向：真正的差异点
const designChoices = [
  { issue: '金额用文本存、聚合时退回浮点，长期累计会差钱', solution: 'money.Money = int64 分，全链路无浮点，HALF_UP 舍入' },
  { issue: '退货靠写负数金额，各报表对负数的处理还不一致', solution: '金额永远非负，冲销用红字凭证（借贷互换），报表自然抵消' },
  { issue: '会计日期存成 UTC 午夜，日期筛选退化成字符串比较', solution: 'calendar.Date 只有年月日，比较是数值比较，没有时区漂移' },
  { issue: '科目没有独立编码与余额方向，备抵科目符号会错', solution: '科目编码独立字段（4-2-2-2），余额方向显式声明' },
  { issue: '只校验借贷相等，可以记到汇总科目上', solution: '过账时强制校验：必须是明细科目且已启用' },
  { issue: '没有会计期间，不能结账，也就没有「已结账」的概念', solution: '会计期间状态机 + 顺序结账 / 逆序反结账' },
];

// 第一版边界
const boundaries = [
  '工资模块必须先配社保方案 —— 程序刻意不预置任何费率，避免「看着像真的」的数字被直接当成当地标准使用。',
  '个税建议从 1 月起连续建单 —— 年中启用时累计收入只有建过单的月份，个税会少扣（界面有提示，暂不支持补录历史累计数）。',
  '小规模纳税人用「价税合计全额计入费用」记账，不能用进项抵扣专栏（程序会明确拒绝并说明正确做法）。',
  '红字发票 / 退货需人工在台账上备注；可抵扣凭证只认专票，通行费、机票火车票、农产品收购发票需人工调整。',
  '税率与抵扣范围已按 2026 年现行文件落到数据里（政策表版本 2026.2，1% 优惠截止 2027-12-31），发布前仍建议复核。',
  '出口业务首版只到「问得清」，不到「做得完」：能判断身份与适用免税 / 零税率，但出口发票、退免税申报表不在首版范围。',
];

const techStack = [
  { name: 'Go', desc: '后端核心语言，编译型高性能，单二进制交付' },
  { name: 'Wails v2', desc: '把 Vue 前端打包成桌面程序，产物 exe / .app / 可执行文件' },
  { name: 'SQLite', desc: '本地单文件账套存储，纯 Go 驱动、无需 C 依赖' },
  { name: 'Vue 3 + Vite', desc: '前端框架与构建，响应式界面、深色模式跟随系统' },
  { name: 'Tailwind v4 + shadcn-vue', desc: '组件令牌与变体约定，社区主题可直接套用' },
  { name: '测试 886 项', desc: '领域层、存储层逐模块单测，另有界面真机冒烟与产物校验测试' },
];
---

<Layout
  title="小账本 Mini Account - 免费本地记账软件 | 中科智农"
  description="小账本（Mini Account）是中科智农开源的本地财务记账软件，面向中国小微企业、个体工商户与代账会计。Windows / macOS / Linux 三平台免费下载，覆盖建账、凭证、银行流水、工资、发票报销、报表与期末结转全流程，数据完全保存在本机。"
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-deep-green to-deep-green/90 text-white">
    <div class="absolute inset-0 opacity-10" style="background-image: linear-gradient(rgba(255,255,255,0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.4) 1px, transparent 1px); background-size: 50px 50px;"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary/20 text-primary text-sm font-medium mb-6">
            <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
            免费开源 · MIT 许可 · {version}
          </span>
          <h1 class="text-4xl lg:text-5xl font-bold mb-4 leading-tight">
            小账本<br />
            <span class="text-primary">Mini Account</span>
          </h1>
          <p class="text-lg text-primary/90 font-medium mb-6">
            面向中国小微企业的本地记账软件
          </p>
          <p class="text-lg text-white/70 mb-8 leading-relaxed">
            一台电脑、一个文件、一套完整的账。从建账、凭证录入、银行流水导入，到工资、发票报销、财务报表与期末结转，
            全流程跑通；账套存在本机，离线可用，永久免费，无需注册。
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="#download" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-primary text-primary-foreground font-medium hover:bg-primary/90 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3" />
              </svg>
              立即下载（三平台）
            </a>
            <a href="#intro" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-white/30 text-white font-medium hover:bg-white/10 transition-colors">
              软件简介
            </a>
          </div>
        </div>
        <!-- 产品预览 -->
        <div class="relative">
          <div class="rounded-2xl bg-background/95 p-2 shadow-2xl">
            <div class="rounded-xl overflow-hidden bg-muted">
              <div class="flex items-center gap-2 px-4 py-3 border-b border-border bg-card">
                <div class="flex gap-1.5">
                  <span class="w-3 h-3 rounded-full bg-red-400"></span>
                  <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
                  <span class="w-3 h-3 rounded-full bg-green-400"></span>
                </div>
                <span class="text-xs text-muted-foreground ml-2">小账本 — 记账凭证</span>
              </div>
              <div class="p-4 space-y-3 text-sm">
                <div class="flex justify-between items-center p-2 rounded bg-background">
                  <span class="text-muted-foreground">凭证字号</span>
                  <span class="font-medium">记 - 2026-03 - 0012</span>
                </div>
                <div class="grid grid-cols-2 gap-2">
                  <div class="p-2 rounded bg-background">
                    <div class="text-xs text-muted-foreground mb-1">借方</div>
                    <div class="font-mono font-medium">银行存款</div>
                    <div class="text-xs text-muted-foreground">1002 - 工商银行</div>
                  </div>
                  <div class="p-2 rounded bg-background">
                    <div class="text-xs text-muted-foreground mb-1">贷方</div>
                    <div class="font-mono font-medium">应收账款</div>
                    <div class="text-xs text-muted-foreground">1122 - 客户A</div>
                  </div>
                </div>
                <div class="flex justify-between p-2 rounded bg-primary/10 text-primary font-medium">
                  <span>合计</span>
                  <span>¥ 50,000.00</span>
                </div>
                <div class="flex items-center justify-between text-xs text-muted-foreground">
                  <span class="flex items-center gap-2">
                    <span class="inline-block w-2 h-2 rounded-full bg-green-500"></span>
                    借贷平衡 ✓
                  </span>
                  <span>记账人：李会计</span>
                </div>
              </div>
            </div>
          </div>
          <div class="absolute -top-4 -right-4 px-4 py-2 rounded-xl bg-primary text-primary-foreground text-sm font-bold shadow-lg rotate-3">
            全免费
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 软件简介 -->
  <section id="intro" class="py-16 lg:py-24 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- 简介正文 -->
        <div class="lg:col-span-2">
          <span class="inline-block px-3 py-1 rounded-full bg-cream text-primary text-xs font-medium mb-4">软件简介</span>
          <h2 class="text-3xl lg:text-4xl font-bold mb-6 text-deep-green">
            小账本是什么
          </h2>
          <div class="space-y-5 text-muted-foreground leading-relaxed">
            <p>
              <strong class="text-foreground">小账本（Mini Account）</strong>
              是中科智农自研并开源的桌面财务记账软件，专门面向中国的小微企业、个体工商户和代理记账会计。
              它不是「表格 + 宏」的记账模板，而是一套按中国企业会计准则实现的完整记账系统：
              科目体系、会计期间、凭证状态机、过账引擎、报表公式引擎都按会计规则从零写起，
              目标是让不懂 IT 的会计能安心把一本真账放在里面。
            </p>
            <p>
              整个软件只有<strong class="text-foreground">一个可执行文件</strong>：
              前端界面用 <code class="px-1.5 py-0.5 rounded bg-muted text-sm">//go:embed</code> 编进二进制，
              不需要额外安装 Web 服务器、数据库服务或运行时环境。
              账套是一个本地 SQLite 文件，默认放在
              <code class="px-1.5 py-0.5 rounded bg-muted text-sm">~/.mini-account/dataDB/</code>，
              断网也能记账，财务数据不出本机；要备份就把这个目录整个拷走。
            </p>
            <p>
              功能上，从<strong class="text-foreground">建账 → 记账 → 银行流水导入 → 工资 → 发票报销 → 出报表 → 期末结转 → 导出 → 备份 → AI 辅助记账</strong>
              整条链路已经跑通，并且每个平台压缩包里都同时提供
              <strong class="text-foreground">界面版「小账本」</strong>和
              <strong class="text-foreground">命令行版「miniaccount」</strong> ——
              命令行版是纯 Go、无图形依赖，界面版跑不起来时（例如老 Linux 发行版的 GLIBC 版本不够）可以直接用它，
              功能与界面版对等。
            </p>
            <p>
              软件以 <strong class="text-foreground">MIT 许可</strong>开源发布，独立实现，
              免费、无注册、无功能阉割、无数据上云，欢迎下载后先用「一键生成演示账套」看看效果再录自己的账。
            </p>
          </div>

          <!-- 适用对象 -->
          <h3 class="text-xl font-bold text-deep-green mt-10 mb-5">谁适合用小账本</h3>
          <div class="grid sm:grid-cols-2 gap-4">
            {audiences.map((a) => (
              <div class="flex gap-3 p-4 rounded-xl border border-border bg-card">
                <span class="text-2xl shrink-0">{a.icon}</span>
                <div>
                  <div class="font-bold mb-1">{a.title}</div>
                  <p class="text-sm text-muted-foreground leading-relaxed">{a.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- 规格信息 -->
        <aside class="lg:col-span-1">
          <div class="rounded-2xl border border-border bg-card p-6 lg:sticky lg:top-24">
            <h3 class="font-bold text-lg mb-4 text-deep-green">软件信息</h3>
            <dl class="space-y-4">
              {specs.map((s) => (
                <div class="border-b border-border last:border-0 pb-3 last:pb-0">
                  <dt class="text-xs text-muted-foreground mb-1">{s.label}</dt>
                  <dd class="text-sm font-medium text-foreground break-words">{s.value}</dd>
                </div>
              ))}
            </dl>
            <div class="mt-6 space-y-2 text-xs text-muted-foreground">
              <div>提交：<code class="font-mono">{commit}</code></div>
              <div>命令行执行 <code class="font-mono">miniaccount version</code> 可打印版本号与构建时间，报问题时带上这一行即可对上是哪次构建。</div>
            </div>
          </div>
        </aside>
      </div>

      <!-- 核心特性 -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-16">
        {highlights.map((h) => (
